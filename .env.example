# Copy this to `.env` and fill in real values. Never commit `.env`.
#
# Supabase Postgres
#   DATABASE_URL = Transaction Pooler URL (port 6543) with `?pgbouncer=true&connection_limit=1`
#   DIRECT_URL   = Session Pooler URL (port 5432) — used by `prisma db push` / migrations
#
# URL-encode special chars in the password ($ -> %24, @ -> %40, etc.).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Single-password gate over the whole dashboard (no per-user accounts).
# DASHBOARD_PASSWORD — RETIRED. Sign-in is Supabase Auth now (see below).

# 32+ random bytes; sign auth cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_COOKIE_SECRET — RETIRED with the password gate.

# Vercel AI Gateway key — powers the Slide 5 "Generate outlook" button.
# Leave blank to skip; the button will appear but error.
AI_GATEWAY_API_KEY=""

# --- Shared SEED CL identity (Supabase Auth) ---
# Same project as the sales dashboard: one auth.users table across every
# department. Access to THIS dashboard = "gm" in your app.staff.departments.
# Values: Supabase Studio -> salesreport -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://fgqiwitiqwftvfhkchpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...   # anon / publishable key — safe in the browser

# --- Database ---
# Now the salesreport project, schema `gm`. Note ?schema=gm on BOTH.
# DATABASE_URL = pooled  (port 6543, pgbouncer)  DIRECT_URL = direct (port 5432)
# DATABASE_URL=postgresql://...:6543/postgres?pgbouncer=true&schema=gm
# DIRECT_URL=postgresql://...:5432/postgres?schema=gm
